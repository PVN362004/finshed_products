<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="producting_routing_form" model="ir.ui.view">
        <field name="name">product.routing.form</field>
        <field name="model">product.routing</field>
        <field name="arch" type="xml">
            <form string="Thong tin in tem">
                <sheet>
                    <group>
                        <field name="product_relate"/>
                        <field name="product_name"/>
                        <field name="product_code"/>
                        <field name="customer_name"/>
                        <field name="quantity" class="text-center"/>
                        <field name="delivery_date"/>
                        <field name="pallet_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="producting_routing_list" model="ir.ui.view">
        <field name="name">product.routing.list</field>
        <field name="model">product.routing</field>
        <field name="arch" type="xml">
            <list string="Thong tin in tem">
                <field name="product_code" string="Mã hàng"/>
                <field name="product_name" string="Tên hàng"/>
                <field name="customer_name" string="Khách hàng"/>
                <field name="quantity" string="Số lượng" class="text-center"/>
                <field name="delivery_date" string="Ngày giao"/>
                <field name="pallet_number" string="Số pallet" class="text-center"/>

            </list>
        </field>
    </record>

    <record id="action_product_routing" model="ir.actions.act_window">
        <field name="name">Thong tin tem hanh trinh</field>
        <field name="res_model">product.routing</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <menuitem id="menu_action_product_routing"
                name="Tem hanh trinh"
                parent="menu_finished_product_root"
                action="action_product_routing"
                sequence="20"/>

</odoo>
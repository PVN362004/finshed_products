<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finished_product_form" model="ir.ui.view">
        <field name="name">finished.product.form</field>
        <field name="model">finished.product</field>
        <field name="arch" type="xml">
            <form string="Thong tin san pham">
                <sheet>
                    <group>
                        <field name="product_name"/>
                        <field name="product_code"/>
                        <field name="customer_name"/>
                        <field name="quantity"/>
                        <field name="date_finished"/>
                        <field name="delivery_date"/>
                        <field name="pallet_number"/>
                        <field name="quantity_per_pallet" readonly="1"/>
                        <field name="note"/>
                        <field name="manufacturing_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_finished_product_list" model="ir.ui.view">
        <field name="name">finished.product.list</field>
        <field name="model">finished.product</field>
        <field name="arch" type="xml">
            <list string="Thong tin san pham">
                <field name="product_code" string="Mã hàng"/>
                <field name="product_name" string="Tên hàng"/>
                <field name="customer_name" string="Khách hàng"/>
                <field name="quantity" string="Số lượng" class="text-center"/>
                <field name="manufacturing_date" string="Ngày sản xuất"/>
                <field name="delivery_date" string="Ngày giao"/>
                <field name="pallet_number" string="Số pallet" class="text-center"/>
                <field name="quantity_per_pallet" string="SL/Pallet" class="text-center" readonly="1"/>
                <field name="date_finished" string="Ngày nhập"/>
                <field name="note" string="Ghi chú"/>
            </list>
        </field>
    </record>

    <record id="action_finished_product" model="ir.actions.act_window">
        <field name="name">Thong tin san pham</field>
        <field name="res_model">finished.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_finished_product_root"
                name="San pham da hoan thanh"
                sequence="10"/>
    
    <menuitem id="menu_finished_product_action"
                name="Tem thanh pham"
                parent="menu_finished_product_root"
                action="action_finished_product"
                sequence="10"/>

</odoo>
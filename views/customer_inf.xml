<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_information_form" model="ir.ui.view">
     <field name="name">finished.product.customer_name.form</field>
        <field name="model">finished.product</field>
        <field name="arch" type="xml">
            <form string="Khách hàng">
                <sheet>
                    <div class="oe_title">
                        <label for="customer_name" string="Khách hàng"/>
                        <h1>
                            <field name="customer_name"
                                placeholder="VD: 1"
                                default_focus="1"
                                options="{'line_breaks': False}"
                                class="w-100 text-break"/>
                        </h1>
                    </div>
                    <group>
                        <field name="customer_address"/>
                        <field name="customer_email"/>
                        <field name="customer_phone_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_information_list" model="ir.ui.view">
        <field name="name">finished.product.customer_name.list</field>
        <field name="model">finished.product</field>
        <field name="arch" type="xml">
            <list string="Khách hàng">
                <field name="customer_name" string="Khách hàng"/>
                <field name="customer_address" string="Địa chỉ"/>
                <field name="customer_email" string="Email" width="450px"/>
                <field name="customer_phone_number" string="Số điện thoại" width="300px"/>
            </list>
        </field>
    </record>


     <record id="action_customer_information" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">finished.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'list', 'view_id': ref('view_customer_information_list')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('view_customer_information_form')}),
                ]"/>
    </record>
    
    <menuitem id="menu_customer_names_action"
                name="Nhập tên khách hàng"
                parent="menu_finished_product_root"
                action="action_customer_information"
                sequence="20"/>

</odoo>